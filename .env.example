GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_ENABLED=false
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_GENAI_MODEL=gemini-3.5-flash-lite
GOOGLE_GENAI_YOUTUBE_MODEL=gemini-2.5-flash-lite
GOOGLE_GENAI_MAX_OUTPUT_TOKENS=4096
GOOGLE_GENAI_YOUTUBE_MAX_OUTPUT_TOKENS=8192
YOUTUBE_SEARCH_ENABLED=false
YOUTUBE_API_KEY=
COMPUTER_EXECUTION_BOUNDARY=managed_local_directory
COMPUTER_BROWSER_ENABLED=false

FIRESTORE_DATABASE=
GCS_BUCKET=

APP_ENV=development
APP_PORT=8080
LOG_LEVEL=INFO

# Evidence store. Without these the application runs and reports that
# library-scale evidence is not durable; it does not fail.
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# Required by the endpoints that reach a provider once GOOGLE_GENAI_ENABLED is
# true. The QC console never needs it: reading stored evidence and recomputing
# a verdict from stored samples costs nothing. With provider calls enabled and
# this unset, those endpoints refuse rather than serve.
#
# When it is set, /api/status reports spend_token_required and the console
# shows a field in its toolbar; the operator pastes the token there and it is
# sent as X-Aprendiz-Spend-Token. It is held in sessionStorage, so it is gone
# when the tab closes. Anyone who can open the console and knows the token can
# spend, which is the trade a shared secret in a browser always makes.
SPEND_TOKEN=

# --- Spending ceiling ------------------------------------------------------
#
# A ceiling the application enforces on itself, in your own currency, per
# calendar month (UTC). This is not a cloud budget: a budget sends mail after a
# threshold is crossed and the spending continues, whereas reaching this makes
# the paid endpoints refuse with 402 until the month rolls over or you raise it.
#
# Leave SPEND_CEILING unset for no ceiling. The prices are per million tokens
# and have no default on purpose -- a guessed price gives a ceiling that is
# wrong in an unknown direction while still reading as protection, so a ceiling
# set without them makes the paid endpoints refuse. Copy the current numbers
# from the provider's pricing page for the model you run, and revisit them:
# published prices change and nothing here will notice.
#
# It is a ceiling, not a hard guarantee: the check runs before a call and the
# cost is known only after it, so calls already in flight still complete. It
# also depends on the ledger being durable, so check records_survive_restart in
# /api/status -- an unwritable ledger under-counts and the ceiling drifts.
SPEND_CURRENCY=PEN
SPEND_CEILING=
PRICE_PER_MILLION_INPUT_TOKENS=
PRICE_PER_MILLION_OUTPUT_TOKENS=
