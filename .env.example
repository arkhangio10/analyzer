GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_ENABLED=false
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_GENAI_MODEL=gemini-3.5-flash-lite
GOOGLE_GENAI_YOUTUBE_MODEL=gemini-2.5-flash-lite
GOOGLE_GENAI_MAX_OUTPUT_TOKENS=4096
GOOGLE_GENAI_YOUTUBE_MAX_OUTPUT_TOKENS=8192
YOUTUBE_SEARCH_ENABLED=false
YOUTUBE_API_KEY=
COMPUTER_EXECUTION_BOUNDARY=managed_local_directory
COMPUTER_BROWSER_ENABLED=false

FIRESTORE_DATABASE=
GCS_BUCKET=

APP_ENV=development
APP_PORT=8080
LOG_LEVEL=INFO

# Evidence store. Without these the application runs and reports that
# library-scale evidence is not durable; it does not fail.
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# Required by the endpoints that reach a provider once GOOGLE_GENAI_ENABLED is
# true. The QC console never needs it: reading stored evidence and recomputing
# a verdict from stored samples costs nothing. With provider calls enabled and
# this unset, those endpoints refuse rather than serve.
SPEND_TOKEN=
