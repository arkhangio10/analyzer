.venv/
venv/
.runtime/
__pycache__/
*.py[cod]

.env
.env.*
!.env.example

.pytest_cache/
.coverage
htmlcov/

.vscode/
.idea/

dist/
build/
*.egg-info/

exports/*
!exports/.gitkeep

data/skills/*
!data/skills/.gitkeep

# The frozen evaluation set is project evidence, not user data: it stays in Git
# so the answers a model is graded against can be reviewed and protected.
!data/evaluations/*.json
!data/evaluations/README.md

data/examples/*
!data/examples/.gitkeep

data/records/

# The pose model is a fetched build input, not source. scripts/fetch_pose_model.py
# gets it against a pinned checksum, so the bytes never need to live in git.
models/

# Generated on demand by scripts/make_synthetic_walk.py; it is output,
# not source, and regenerating it is one command.
synthetic-walk*.mp4
thumbnail-3x2.png
project-story.txt
built-with.txt
